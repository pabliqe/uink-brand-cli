{
  "name": "uink-brand-cli",
  "version": "1.0.5",
  "description": "UINK Tools CLI for generating PWA assets, Open Graph images, and meta tags from DTCG design tokens",
  "type": "module",
  "bin": {
    "uink-brand": "./bin/cli.js"
  },
  "exports": {
    ".": "./bin/cli.js",
    "./lib/parser.js": "./lib/parser.js",
    "./lib/generator.js": "./lib/generator.js",
    "./lib/meta-generator.js": "./lib/meta-generator.js",
    "./lib/rasterize.js": "./lib/rasterize.js"
  },
  "scripts": {
    "test": "npm run test:core",
    "test:core": "node --test test/*.js",
    "test:cli": "node bin/cli.js --brand brand.example.json --force",
    "build:changelog": "node scripts/update-changelog.mjs",
    "prepublishOnly": "echo 'Ready to publish'"
  },
  "keywords": [
    "og-image",
    "meta-tags",
    "pwa",
    "manifest",
    "design-tokens",
    "dtcg",
    "seo",
    "social-media",
    "cli",
    "generator",
    "brand",
    "favicon"
  ],
  "author": "Pablo Armen <pabliqe@github>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pabliqe/uink-brand-cli.git"
  },
  "bugs": {
    "url": "https://github.com/pabliqe/uink-brand-cli/issues"
  },
  "homepage": "https://github.com/pabliqe/uink-brand-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "lib/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "satori": "^0.10.0"
  }
}
